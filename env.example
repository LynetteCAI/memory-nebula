# Cloudflare Configuration
# Copy this file to .env.local and fill in your values
#
# Optional: only needed for cloud sharing / R2 upload.
# If you only use local IndexedDB storage, you can skip all Cloudflare variables.

CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_SECRET_ACCESS_KEY=
CLOUDFLARE_R2_BUCKET_NAME=memory-nebula-photos
CLOUDFLARE_R2_PUBLIC_URL=
CLOUDFLARE_KV_NAMESPACE_ID=
CLOUDFLARE_KV_API_TOKEN=

# NOTE: Gemini AI features are not currently active in the frontend.
# The GEMINI_API_KEY define has been removed from vite.config.ts to prevent
# accidental key exposure in client-side JS bundles.
# If you want to use Gemini AI in the future, implement a backend proxy
# (e.g. Vercel Serverless Function) instead of injecting the key into the frontend.
#
# Optional: only needed if using Gemini AI features via backend proxy
GEMINI_API_KEY=
