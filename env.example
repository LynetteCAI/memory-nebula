# Cloudflare Configuration
# Copy this file to .env.local and fill in your values
#
# Optional: only needed for cloud sharing / R2 upload.
# If you only use local IndexedDB storage, you can skip all Cloudflare variables.

CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_SECRET_ACCESS_KEY=
CLOUDFLARE_R2_BUCKET_NAME=memory-nebula-photos
CLOUDFLARE_R2_PUBLIC_URL=
CLOUDFLARE_KV_NAMESPACE_ID=
CLOUDFLARE_KV_API_TOKEN=

# Optional: only needed if using Gemini AI features
GEMINI_API_KEY=
