# dependencies
node_modules/

# build output
dist/
dist-ssr/
build/
.vite/
.cache/

# logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# system / editor
.DS_Store
.idea/
.vscode/*
!.vscode/extensions.json
*.sw?
*.suo
*.ntvs*
*.njsproj
*.sln

# local env
.env
.env.*
!.env.example

# local / personal config
*.local
.claude/

# backup files
*.backup
*.backup.*
package-lock.backup.json
memory-nebula-backup-*.json
memory-backup-*.json
memories-backup-*.json
*.memory-export.json

# local photo data (user-uploaded images, not project assets)
public/photos/*
!public/photos/.gitkeep
*.jpg
*.jpeg
*.png
*.heic
*.webp

# optional local model cache
public/models/*.task
!public/models/.gitkeep

# vercel
.vercel
.env*.local

# temp / cache
tmp/
.temp/
*.swp
*.swo
*~

# TypeScript
*.tsbuildinfo

# test output
.vite/test/

# dev / debug
dev/
debug/

# private user data directories — add any local-only folders here
# (avoid global extension ignores that could block project assets)
private/
local-data/
uploads/
exports/
backups/
.user-data/

# private keys / certs (additional safety)
*.pem
*.key
*.p12
*.pfx
*.cert
*.crt
*.der
*.p8
*.pkcs8

# (backup patterns defined above in the #backup section)
